# ==============================================================================
# MARKETPLACE REACT NATIVE MOBILE APP ENVIRONMENT CONFIGURATION
# ==============================================================================

# Public API Base URL:
# - Android Emulator: http://10.0.2.2:3000
# - iOS Simulator:    http://localhost:3000
# - Physical Device:  http://<YOUR_COMPUTER_LAN_IP>:3000  (e.g., http://192.168.1.50:3000)
# - Production:       https://marketplace.example.com
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Launch Geography Defaults
EXPO_PUBLIC_DEFAULT_CITY=Metropolis
EXPO_PUBLIC_DEFAULT_CITY_CODE=METRO

# Google OAuth 2.0 Client IDs (Public client configuration)
# 1. Visit https://console.cloud.google.com/apis/credentials
# 2. Add an OAuth 2.0 Client ID for Web / Android / iOS
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Note: Never add secret keys (MONGODB_URI, AUTH_SECRET, Google Client Secret) to this file.
# Mobile client bundles can be decompiled; all secrets remain strictly on the backend.
